{
  "name": "@dionfang/tokensaver",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "TokenSaver 本地语义代码索引。Ollama 或 transformers.js,模型权重需本机自备。",
  "bin": {
    "tokensaver": "cli.mjs"
  },
